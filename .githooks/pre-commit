#!/bin/sh
# pre-commit hook: AppClassifier değişince duplicate kontrolü yap, varsa commit'i blokla.
# Kurulum: scripts/install_hooks.ps1 veya manuel:
#   cp .github/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit

CLASSIFIER="app/src/main/assets/app_categories.json"

# app_categories.json veya AppClassifier bu commit'te değişiyor mu?
if git diff --cached --name-only | grep -E -q "app_categories\.json|AppClassifier\.kt"; then
  echo "🔍 Kategori kataloğu değişti — duplicate kontrolü yapılıyor..."

  # Python bul
  if command -v python3 >/dev/null 2>&1; then
    PY=python3
  elif command -v python >/dev/null 2>&1; then
    PY=python
  else
    echo "⚠️  Python bulunamadı, duplicate kontrolü atlandı."
    exit 0
  fi

  # check_duplicates.py çalıştır (PYTHONIOENCODING=utf-8 ile Windows CP1254 sarmalaması önlenir)
  if [ -f "scripts/check_duplicates.py" ]; then
    PYTHONIOENCODING=utf-8 $PY scripts/check_duplicates.py "$CLASSIFIER"
    EXIT=$?
    if [ $EXIT -ne 0 ]; then
      echo ""
      echo "❌ COMMIT ENGELLENDI: Kategori kataloğunda duplicate paket var!"
      echo "   Düzeltmek için: python3 scripts/dedup_classifier.py"
      echo "   Sonra tekrar: git add app/src/main/assets/app_categories.json && git commit"
      exit 1
    fi
    echo "✅ Duplicate yok — commit devam ediyor."
  else
    echo "⚠️  scripts/check_duplicates.py bulunamadı, kontrol atlandı."
  fi
fi

exit 0
